# true  = mock data + built-in alert simulator (no backend needed)
# false = real FastAPI backend (REST + WebSocket)
VITE_USE_MOCK=true

# FastAPI REST base URL (used when VITE_USE_MOCK=false)
VITE_API_URL=http://localhost:8000/api

# WebSocket URL for live alerts / detections / plate reads
VITE_WS_URL=ws://localhost:8000/ws
